# Entity: payment

main: kit: entity: payment: {

  alias: field: {}

  fields: [
    {
      name: "address"
      req: false
      type: "`$STRING`"
    }
    {
      name: "api_key"
      req: true
      type: "`$STRING`"
    }
    {
      name: "chain"
      req: false
      type: "`$STRING`"
    }
    {
      name: "credits_added"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "ok"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "rate"
      req: false
      type: "`$STRING`"
    }
    {
      name: "token"
      req: false
      type: "`$STRING`"
    }
    {
      name: "total_credits"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "tx_hash"
      req: true
      short: "Transaction hash of USDC transfer on Base"
      type: "`$STRING`"
    }
    {
      name: "usdc"
      req: false
      type: "`$NUMBER`"
    }
  ]

  name: "payment"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /api/credits/topup"
            json: "{\"operationId\":\"topupCredits\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"api_key\":{\"type\":\"string\"},\"tx_hash\":{\"description\":\"Transaction hash of USDC transfer on Base\",\"type\":\"string\"}},\"required\":[\"api_key\",\"tx_hash\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"credits_added\":{\"type\":\"integer\"},\"ok\":{\"type\":\"boolean\"},\"total_credits\":{\"type\":\"integer\"},\"usdc\":{\"type\":\"number\"}},\"type\":\"object\"}}},\"description\":\"Credits added\"}},\"security\":[],\"securitySchemes\":{\"bearerAuth\":{\"description\":\"Your API key from POST /api/keys/create. Free tier: 50 req/day without a key. Paid: Bearer <api_key> for full access.\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/api/credits/topup"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "credits"
            }
            {
              lit: "topup"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          contract: {
            id: "GET /api/payments/info"
            json: "{\"operationId\":\"getPaymentInfo\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"address\":{\"type\":\"string\"},\"chain\":{\"example\":\"Base (L2)\",\"type\":\"string\"},\"rate\":{\"example\":\"500 credits per 1 USDC\",\"type\":\"string\"},\"token\":{\"example\":\"USDC\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Payment details\"}},\"security\":[],\"securitySchemes\":{\"bearerAuth\":{\"description\":\"Your API key from POST /api/keys/create. Free tier: 50 req/day without a key. Paid: Bearer <api_key> for full access.\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/api/payments/info"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "payments"
            }
            {
              lit: "info"
            }
          ]
          select: {
            "$action": "info"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
